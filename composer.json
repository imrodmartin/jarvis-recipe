        "drupal/gemini_provider": "^1.0",
        "drupal/key": "^1.19",
        "drupal/linkit": "^7.0",
        "drupal/metatag": "^2.2",
        "drupal/save_edit": "^2.1",
        "drupal/simple_gmap": "^4.0",
        "drupal/token_filter": "^2.2",
        "drupal/twig_tweak": "^3.4",
