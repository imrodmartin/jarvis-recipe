{
    "name": "imrodmartin/jarvis-recipe",
    "description": "Drupal recipe that turns a blank site into a fully functional Jarvis site: the Jarvis theme (WCAG 2.2 AA safeguards), Drupal Canvas with folders/patterns/templates, demo content incl. Canvas pages, forms, editorial workflow, SEO, Editoria11y, admin UX, and a configured (keyless) AI stack.",
    "type": "drupal-recipe",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/imrodmartin/jarvis-bootstrap-recipe",
    "require": {
        "php": ">=8.3",
        "drupal/jarvis": "^2.1",
        "imrodmartin/jarvis-modules": "^1.0",
        "drupal/ai": "^1.4",
        "drupal/ai_agents": "^1.3",
        "drupal/ai_image_alt_text": "^1.0",
        "drupal/ai_media_image": "^1.0@alpha",
        "drupal/ai_provider_anthropic": "^1.2",
        "drupal/ai_provider_openai": "^1.2",
        "drupal/antibot": "^2.0",
        "drupal/asset_injector": "^2.21",
        "drupal/back_to_top": "^3.0",
        "drupal/backup_migrate": "^5.1",
        "drupal/better_exposed_filters": "^7.1",
        "drupal/better_social_sharing_buttons": "^5.0",
        "drupal/canvas": "^1.8",
        "drupal/canvas_ai": "^1.8",
        "drupal/canvas_field_component": "^1.0",
        "drupal/ckeditor5_markdown": "^1.0",
        "drupal/coffee": "^2.0",
        "drupal/default_content": "^2.0@beta",
        "drupal/editoria11y": "^3.0",
        "drupal/elevenlabs": "^1.1",
